<?xml version="1.0" encoding="utf-8"?>
<!-- カメラ画面（横画面固定）：左にプレビュー、右に操作パネル -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:orientation="horizontal"
    tools:context=".ui.CameraActivity">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- ガイド枠（サンプル撮影・判定共通）。枠内だけを判定に使う -->
        <com.example.eringchecker.camera.GuideOverlayView
            android:id="@+id/guideOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 判定結果の〇／×オーバーレイ（OK/NG 確定時のみ表示） -->
        <ImageView
            android:id="@+id/imageVerdictMark"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:visibility="gone"
            tools:src="@drawable/ic_result_ok"
            tools:visibility="visible" />

        <!-- 判定結果（判定モードのみ表示） -->
        <LinearLayout
            android:id="@+id/resultBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@color/result_neutral"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/textResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/result_waiting"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 工具認識中マーク（判定モードで工具が写っている間だけ表示） -->
        <TextView
            android:id="@+id/textToolDetected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:shadowColor="#CC000000"
            android:shadowRadius="4"
            android:text="@string/mark_tool_detected"
            android:textColor="@color/tool_detected"
            android:textSize="32sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- テスト用：AI の OK・NG・工具なしの％（AI_SHOW_DEBUG_SCORES で表示切替。不要になったら削除してよい） -->
        <TextView
            android:id="@+id/textAiScores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="8dp"
            android:background="#99000000"
            android:fontFamily="monospace"
            android:padding="4dp"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="OK 95%\nNG 3%\n工具なし 2%"
            tools:visibility="visible" />
    </FrameLayout>

    <!-- 操作パネル -->
    <ScrollView
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:background="@color/panel_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/textModeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="サンプル撮影: AK-17A" />

            <!-- サンプル撮影モード用パネル -->
            <LinearLayout
                android:id="@+id/samplePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_no_ring"
                            android:textColor="@android:color/white" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="96dp"
                            android:background="@color/thumb_background">

                            <ImageView
                                android:id="@+id/imageNoRing"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/label_no_ring"
                                android:scaleType="centerCrop" />

                            <TextView
                                android:id="@+id/textNoRingEmpty"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="@string/no_image"
                                android:textColor="@android:color/white" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_has_ring"
                            android:textColor="@android:color/white" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="96dp"
                            android:background="@color/thumb_background">

                            <ImageView
                                android:id="@+id/imageHasRing"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/label_has_ring"
                                android:scaleType="centerCrop" />

                            <TextView
                                android:id="@+id/textHasRingEmpty"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="@string/no_image"
                                android:textColor="@android:color/white" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_background"
                            android:textColor="@android:color/white" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="96dp"
                            android:background="@color/thumb_background">

                            <ImageView
                                android:id="@+id/imageBackground"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/label_background"
                                android:scaleType="centerCrop" />

                            <TextView
                                android:id="@+id/textBackgroundEmpty"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="@string/no_image"
                                android:textColor="@android:color/white" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonCaptureNoRing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_capture_no_ring" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonCaptureHasRing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_capture_has_ring" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonCaptureBackground"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_capture_background" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonGoJudge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/result_ok"
                    android:enabled="false"
                    android:text="@string/btn_go_judge" />
            </LinearLayout>

            <!-- 判定モード用パネル -->
            <LinearLayout
                android:id="@+id/judgePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonGoSample"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_go_sample"
                    android:textColor="@android:color/white" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
